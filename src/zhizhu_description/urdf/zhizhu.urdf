<?xml version="1.0"?>
<!--
  zhizhu (spider) assembly.

  Used by RViz (display.launch.py) and by gazebo_spawn.launch.py (spawn_entity).
  For a static display that always works, gazebo.launch.py loads worlds/zhizhu.world
  which embeds the model directly as SDF.

  Mesh: meshes/zhizhu.stl (single binary STL, CAD units = mm).
  Bounding box (mm): X 36.9..3712.5  Y 126.2..1910.8  Z 1000.0..1894.4
  => ~3.68 x 1.78 x 0.89 m.

  * scale="0.001 ..."  : mm -> m.
  * rpy="3.14159 0 0"  : roll 180 deg about X (CAD export was upside down; the
    suction-cup side faces UP after this). Flip about the other axis instead
    with rpy="0 3.14159 0" and xyz="1.8747 -1.0185 1.8944".
  * origin xyz="-1.8747 1.0185 1.8944" : re-centres and grounds the flipped
    mesh so it sits on z=0.
  * A box <collision> + <inertial> so the model can be spawned with physics for
    future motion. The box approximates the flipped model (3.68 x 1.78 x 0.89 m,
    centred 0.447 m above the ground).
-->
<robot name="zhizhu">

  <material name="zhizhu_gray">
    <color rgba="0.7 0.7 0.72 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="-1.8747 1.0185 1.8944" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/zhizhu.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="zhizhu_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.447" rpy="0 0 0"/>
      <geometry>
        <box size="3.68 1.78 0.894"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10.0"/>
      <inertia ixx="3.3" ixy="0.0" ixz="0.0" iyy="11.9" iyz="0.0" izz="13.9"/>
    </inertial>
  </link>

</robot>
