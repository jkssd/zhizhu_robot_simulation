  <xacro:leg name="lm" hip="-0.3772 -0.0234 0.4559" knee="-0.6265 0.0103 0.0005" ankle="-0.7223 0.0468 -0.1850" hip_axis="0.0000 0.0000 1.0000" knee_axis="0.0183 0.9998 -0.0000" ankle_axis="-0.9998 0.0183 0.0000" coxa_origin="-0.4133 0.0314 0.0647" femur_origin="-0.4518 0.0333 -0.1382" foot_origin="0.0098 -0.0081 -0.0653" coxa_box="0.723 0.116 0.192" femur_box="0.818 0.111 0.337" foot_box="0.204 0.202 0.209"/>
  <xacro:leg name="lr" hip="-0.3693 -0.2232 0.4541" knee="-0.5889 -0.2758 0.1050" ankle="-0.6218 -0.3037 -0.2112" hip_axis="0.0000 0.0000 1.0000" knee_axis="-0.4290 0.9033 0.0000" ankle_axis="-0.9033 -0.4290 0.0000" coxa_origin="-0.3733 -0.2018 0.0580" femur_origin="-0.3955 -0.2162 -0.1580" foot_origin="0.0002 -0.0129 -0.0580" coxa_box="0.707 0.404 0.165" femur_box="0.755 0.398 0.336" foot_box="0.202 0.204 0.211"/>

</robot>