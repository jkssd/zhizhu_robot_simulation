<?xml version="1.0"?>
<robot name="zhizhu" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="zhizhu_gray"><color rgba="0.7 0.7 0.72 1.0"/></material>

  <xacro:macro name="leg" params="name hip knee ankle hip_axis knee_axis ankle_axis coxa_origin femur_origin foot_origin coxa_ixx coxa_iyy coxa_izz femur_ixx femur_iyy femur_izz foot_ixx foot_iyy foot_izz">
    <link name="${name}_coxa">
      <visual><origin xyz="${coxa_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_coxa.stl"/></geometry><material name="zhizhu_gray"/></visual>
      <collision><origin xyz="${coxa_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_coxa.stl"/></geometry></collision>
      <inertial><mass value="1.5"/><inertia ixx="${coxa_ixx}" ixy="0" ixz="0" iyy="${coxa_iyy}" iyz="0" izz="${coxa_izz}"/></inertial>
    </link>
    <link name="${name}_femur">
      <visual><origin xyz="${femur_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_femur.stl"/></geometry><material name="zhizhu_gray"/></visual>
      <collision><origin xyz="${femur_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_femur.stl"/></geometry></collision>
      <inertial><mass value="1.0"/><inertia ixx="${femur_ixx}" ixy="0" ixz="0" iyy="${femur_iyy}" iyz="0" izz="${femur_izz}"/></inertial>
    </link>
    <link name="${name}_foot">
      <visual><origin xyz="${foot_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_foot.stl"/></geometry><material name="zhizhu_gray"/></visual>
      <collision><origin xyz="${foot_origin}"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/${name}_foot.stl"/></geometry></collision>
      <inertial><mass value="0.8"/><inertia ixx="${foot_ixx}" ixy="0" ixz="0" iyy="${foot_iyy}" iyz="0" izz="${foot_izz}"/></inertial>
    </link>
    <joint name="hip_${name}" type="revolute"><parent link="body"/><child link="${name}_coxa"/><origin xyz="${hip}"/><axis xyz="${hip_axis}"/><limit lower="-1.57" upper="1.57" effort="50" velocity="5"/><dynamics damping="0.5" friction="0.5"/></joint>
    <joint name="knee_${name}" type="revolute"><parent link="${name}_coxa"/><child link="${name}_femur"/><origin xyz="${knee}"/><axis xyz="${knee_axis}"/><limit lower="-1.57" upper="1.57" effort="50" velocity="5"/><dynamics damping="0.5" friction="0.5"/></joint>
    <joint name="ankle_${name}" type="revolute"><parent link="${name}_femur"/><child link="${name}_foot"/><origin xyz="${ankle}"/><axis xyz="${ankle_axis}"/><limit lower="-3.14" upper="3.14" effort="30" velocity="5"/><dynamics damping="0.5" friction="0.5"/></joint>
  </xacro:macro>

  <link name="body">
    <visual><origin xyz="-0.0226 -0.0000 0.6012"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/body.stl"/></geometry><material name="zhizhu_gray"/></visual>
    <collision><origin xyz="-0.0226 -0.0000 0.6012"/><geometry><mesh filename="file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/parts_urdf/body.stl"/></geometry></collision>
    <inertial><mass value="8.0"/><inertia ixx="1.5" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.8"/></inertial>
  </link>

  <xacro:leg name="rf" hip="0.3304 0.2647 0.4563" knee="0.5452 0.2187 0.2207" ankle="0.6843 0.3192 -0.0840" hip_axis="0.0000 0.0000 1.0000" knee_axis="0.4234 -0.9059 0.0000" ankle_axis="0.9059 0.4234 0.0000" coxa_origin="0.3762 0.1602 0.1338" femur_origin="0.4519 0.2318 -0.0762" foot_origin="0.0112 0.0129 -0.0569" coxa_ixx="0.0294" coxa_iyy="0.0689" coxa_izz="0.0803" femur_ixx="0.0167" femur_iyy="0.0544" femur_izz="0.0641" foot_ixx="0.0058" foot_iyy="0.0058" foot_izz="0.0055"/>
