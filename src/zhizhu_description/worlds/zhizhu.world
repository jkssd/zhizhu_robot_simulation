<?xml version="1.0"?>
<!--
  zhizhu static display world (Stage 1: body + 6 virtual feet).

  The model is embedded here directly as SDF (not spawned via spawn_entity),
  because gazebo_ros 3.9.0 + Gazebo Classic 11 does not render visuals of
  models inserted through /spawn_entity in this environment. World-file models
  render correctly.

  Mesh pose: scale 0.001 (mm->m), rpy=0 (flipped back so feet face down),
  grounded so the mesh sits on z=0.
  6 red spheres = ESTIMATED virtual feet positions (refine later).
-->
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.7 0.7 0.75 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="zhizhu">
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <pose>-1.8747 -1.0185 -1.0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/khalil/ROS/zhizhu/install/zhizhu_description/share/zhizhu_description/meshes/zhizhu.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.72 1</ambient>
            <diffuse>0.7 0.7 0.72 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- 6 virtual feet (red spheres, estimated positions) -->
      <link name="foot_lf"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>
      <link name="foot_lm"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>
      <link name="foot_lr"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>
      <link name="foot_rf"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>
      <link name="foot_rm"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>
      <link name="foot_rr"><visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material></visual></link>

      <joint name="body_to_foot_lf" type="fixed"><parent>body</parent><child>foot_lf</child><pose>-1.2 -0.85 0.05 0 0 0</pose></joint>
      <joint name="body_to_foot_lm" type="fixed"><parent>body</parent><child>foot_lm</child><pose>0.0 -0.85 0.05 0 0 0</pose></joint>
      <joint name="body_to_foot_lr" type="fixed"><parent>body</parent><child>foot_lr</child><pose>1.2 -0.85 0.05 0 0 0</pose></joint>
      <joint name="body_to_foot_rf" type="fixed"><parent>body</parent><child>foot_rf</child><pose>-1.2 0.85 0.05 0 0 0</pose></joint>
      <joint name="body_to_foot_rm" type="fixed"><parent>body</parent><child>foot_rm</child><pose>0.0 0.85 0.05 0 0 0</pose></joint>
      <joint name="body_to_foot_rr" type="fixed"><parent>body</parent><child>foot_rr</child><pose>1.2 0.85 0.05 0 0 0</pose></joint>
    </model>
  </world>
</sdf>
